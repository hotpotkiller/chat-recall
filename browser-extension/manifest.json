{
  "manifest_version": 3,
  "name": "Chat Recall — local history bridge",
  "version": "0.1.0",
  "description": "Import ChatGPT conversations into your paired local Chat Recall archive. Experimental account sync; no ChatGPT write actions.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Chat Recall bridge"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
